# Copy to .env and edit. Environment variables override configs/config.yaml.
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Video: file path, webcam index (e.g. 0) or IP camera URL (rtsp:// or http://)
VIDEO_SOURCE=sample_data/traffic.mp4
VIDEO_LOOP=false
VIDEO_MAX_RECONNECT_ATTEMPTS=3
VIDEO_RECONNECT_DELAY_S=2.0

# Preprocessing
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_SKIP=2

# Database (SQLite default; PostgreSQL example below)
DATABASE_URL=sqlite:///./smart_traffic.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smart_traffic

# Config files
CONFIG_FILE=configs/config.yaml
ROI_FILE=configs/rois.json
